# Pilihan provider pencarian: "duckduckgo", "serpapi", "google_custom_search", atau "mock"
# "duckduckgo" -> FREE & LIVE (Default, tanpa perlu API key)
# "serpapi"    -> Menggunakan Google Search via SerpApi (https://serpapi.com)
# "google_custom_search" -> Menggunakan Google Programmable Search Engine JSON API
SEARCH_PROVIDER=duckduckgo

# API Key untuk SerpApi (https://serpapi.com)
SERPAPI_API_KEY=your_serpapi_key_here

# Jika menggunakan Google Programmable Search Engine:
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# Pipeline Performance & Concurrency Settings
MAX_WORKERS=6
MAX_REQUESTS_PER_DOMAIN=2
HTTP_TIMEOUT=15
HTTP_RETRIES=3
HTTP_BACKOFF_FACTOR=0.5

# Guardrails & Limits
MAX_HTML_MB=5
MAX_PDF_MB=25
MAX_DOWNLOAD_MB=100
PDF_MAX_PAGES=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/dork_scout.log
USER_AGENT=DorkScoutPipeline/1.0 (Public OSINT Research)
